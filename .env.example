DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:PORT/placeboard?sslMode=REQUIRED
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/api/google-calendar/oauth/callback
# 32바이트 난수를 Base64로 인코딩한 값. 운영 Secret Manager에 저장하며 Git에 커밋하지 않는다.
GOOGLE_TOKEN_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY
